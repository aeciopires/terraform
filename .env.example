# Copy to .env and load it in every new terminal before working with the
# emulators (the Makefile loads it by itself):
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# With these variables, Terraform/OpenTofu, the AWS CLI, boto3 and the
# Google provider talk to floci (AWS) and floci-gcp (GCP) instead of the real
# clouds. To work with a real AWS account or GCP project, open a NEW
# terminal without them (see REQUIREMENTS.md section 7).
#
# The Terragrunt stacks in live/ do NOT need this file: live/root.hcl sets
# the emulator variables only for accounts with target = "floci".

# --- Host ports (docker-compose.yml) ------------------------------------------
# Change them if another project already uses 4566/4588 - and change the
# URLs below to match.
FLOCI_AWS_PORT=4566
FLOCI_GCP_PORT=4588
# Host ports of the ALB listeners (the dev ALB listens on 8080, stg on 8081).
FLOCI_ALB_HOST_PORTS=8080-8089

# --- floci (AWS) ------------------------------------------------------------------
# *.localhost.floci.io resolves to your own machine (public DNS, see floci's
# docs/services/s3.md), so S3 virtual-hosted requests and the S3 Control API
# work without any provider setting such as s3_use_path_style.
AWS_ENDPOINT_URL=http://localhost.floci.io:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# Read by live/root.hcl (default shown).
FLOCI_AWS_ENDPOINT=http://localhost.floci.io:4566

# --- floci-gcp (GCP) -------------------------------------------------------------
FLOCI_GCP_ENDPOINT=http://localhost:4588
GOOGLE_CLOUD_PROJECT=floci-local
# floci-gcp accepts any token; the Google provider only needs one to exist.
GOOGLE_OAUTH_ACCESS_TOKEN=floci-fake-token
# One variable per API, read by the Google provider (and by the gcs backend
# for GOOGLE_STORAGE_CUSTOM_ENDPOINT). See live/root.hcl for the source.
GOOGLE_STORAGE_CUSTOM_ENDPOINT=http://localhost:4588/storage/v1/
GOOGLE_PUBSUB_CUSTOM_ENDPOINT=http://localhost:4588/v1/
GOOGLE_IAM_BETA_CUSTOM_ENDPOINT=http://localhost:4588/v1/
GOOGLE_RESOURCE_MANAGER_CUSTOM_ENDPOINT=http://localhost:4588/v1/
GOOGLE_SERVICE_USAGE_CUSTOM_ENDPOINT=http://localhost:4588/v1/
GOOGLE_CLOUD_RUN_V2_CUSTOM_ENDPOINT=http://localhost:4588/v2/
GOOGLE_SQL_CUSTOM_ENDPOINT=http://localhost:4588/sql/v1beta4/
GOOGLE_SECRET_MANAGER_CUSTOM_ENDPOINT=http://localhost:4588/v1/
GOOGLE_KMS_CUSTOM_ENDPOINT=http://localhost:4588/v1/
# floci-gcp 0.9.0 has no Compute Engine API: pointing it at the emulator
# anyway guarantees no call reaches the real Google Cloud.
GOOGLE_COMPUTE_CUSTOM_ENDPOINT=http://localhost:4588/compute/v1/

# gcloud CLI against floci-gcp (Pub/Sub and Cloud Storage commands).
CLOUDSDK_CORE_PROJECT=floci-local
CLOUDSDK_API_ENDPOINT_OVERRIDES_PUBSUB=http://localhost:4588/
CLOUDSDK_API_ENDPOINT_OVERRIDES_STORAGE=http://localhost:4588/storage/v1/

# --- Terragrunt -------------------------------------------------------------------
# Which binary Terragrunt runs: tofu (Terragrunt's default) or terraform.
TG_TF_PATH=tofu
